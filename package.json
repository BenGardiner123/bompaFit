{
  "name": "bompa",
  "version": "0.1.0",
  "private": true,
  "description": "Periodization-first workout tracker. Offline-first PWA.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/precache.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "measure": "node scripts/measure-bundle.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "geist": "^1.3.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true
  }
}
